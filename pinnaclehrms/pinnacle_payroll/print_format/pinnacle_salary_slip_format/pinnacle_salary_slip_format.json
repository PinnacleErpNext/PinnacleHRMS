 "font_size": 14,
 "html": "<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      font-size: 13px;\n      color: #333;\n      margin: 0;\n      padding: 0;\n    }\n\n    .salary-slip {\n      width: 100%;\n      margin: 0 auto;\n    }\n\n    h2,\n    h3,\n    h4 {\n      margin: 0;\n      color: #333;\n    }\n\n    .company-name {\n      text-align: center;\n      font-size: 20px;\n      font-weight: bold;\n      margin-bottom: 5px;\n    }\n\n    .salary-title {\n      text-align: center;\n      font-size: 16px;\n      margin-bottom: 20px;\n    }\n\n/* ==============================\n   EMPLOYEE DETAILS\n   ============================== */\n\n.employee-details {\n  width: 100% !important;\n  margin: 0 0 22px 0 !important;\n  border: none !important;\n  border-collapse: collapse !important;\n  table-layout: fixed !important;\n}\n\n.employee-details tr {\n  border: none !important;\n}\n\n.employee-details td {\n  border: none !important;\n  padding: 5px 6px !important;\n  margin: 0 !important;\n  vertical-align: middle !important;\n  line-height: 1.5 !important;\n}\n\n/* All labels */\n.employee-details .label {\n  font-size: 14px !important;\n  font-weight: 700 !important;\n  text-align: left !important;\n  white-space: nowrap !important;\n  padding-left: 0 !important;\n  padding-right: 5px !important;\n}\n\n/* All values */\n.employee-details .value {\n  font-size: 13px !important;\n  font-weight: 400 !important;\n  text-align: left !important;\n  white-space: nowrap !important;\n  padding-left: 5px !important;\n  padding-right: 5px !important;\n}\n\n/* Right-side labels */\n.employee-details td:nth-child(3) {\n  padding-left: 10px !important;\n  padding-right: 5px !important;\n}\n\n/* Right-side values */\n.employee-details td:nth-child(4) {\n  padding-left: 5px !important;\n}\n\n    /* ==============================\n       GENERAL TABLE\n       ============================== */\n\n    table {\n      width: 100%;\n      border-collapse: collapse;\n    }\n\n    /* ==============================\n       SECTION TITLE\n       ============================== */\n\n    .section-title {\n      font-size: 15px;\n      font-weight: bold;\n      margin-top: 20px;\n      margin-bottom: 8px;\n    }\n\n    /* ==============================\n       SALARY TABLE\n       ============================== */\n\n    .salary-table {\n      width: 100%;\n      border-collapse: collapse;\n    }\n\n    .salary-table th,\n    .salary-table td {\n      border: 1px solid #ccc !important;\n      padding: 8px;\n    }\n\n    .salary-table th {\n      background-color: #f2f2f2;\n      font-weight: bold;\n      text-align: left;\n    }\n\n    .salary-table td {\n      text-align: left;\n    }\n\n    .amount {\n      text-align: right !important;\n    }\n\n    .center {\n      text-align: center !important;\n    }\n\n    .total-row th,\n    .total-row td {\n      font-weight: bold;\n      background-color: #f7f7f7;\n    }\n\n    /* ==============================\n       NET PAY\n       ============================== */\n\n    .net-pay {\n      margin-top: 20px;\n      padding: 12px;\n      font-size: 17px;\n      font-weight: bold;\n      text-align: right;\n    }\n\n    /* ==============================\n       BANK DETAILS\n       ============================== */\n\n    .bank-details {\n      width: 100%;\n      margin-top: 20px;\n      border: none !important;\n      border-collapse: collapse;\n    }\n\n    .bank-details td {\n      padding: 7px 10px;\n      border: none !important;\n      vertical-align: top;\n    }\n\n    .bank-details .label {\n      font-weight: bold;\n      width: 18%;\n      border: none !important;\n    }\n\n    .bank-details .value {\n      width: 32%;\n      border: none !important;\n    }\n\n    /* ==============================\n       FOOTER\n       ============================== */\n\n    .footer {\n      margin-top: 30px;\n      text-align: center;\n      font-size: 11px;\n      color: #777;\n    }\n  </style>\n</head>\n\n<body>\n\n<div class=\"salary-slip\">\n\n  <!-- COMPANY -->\n  <div class=\"company-name\">\n    {{ doc.company }}\n  </div>\n\n  <div class=\"salary-title\">\n    Salary Slip for\n    {{ frappe.utils.formatdate(doc.start_date, \"MMMM yyyy\") }}\n  </div>\n\n\n  <!-- ==============================\n     EMPLOYEE DETAILS\n     ============================== -->\n\n{% set employee_date_of_joining = frappe.db.get_value(\n    \"Employee\",\n    doc.employee,\n    \"date_of_joining\"\n) %}\n\n<table class=\"employee-details\">\n\n  <colgroup>\n    <col style=\"width:22%;\">\n    <col style=\"width:28%;\">\n    <col style=\"width:22%;\">\n    <col style=\"width:28%;\">\n  </colgroup>\n\n  <tr>\n    <td class=\"label\">Employee Name</td>\n    <td class=\"value\">{{ doc.employee_name }}</td>\n\n    <td class=\"label\">Employee ID</td>\n    <td class=\"value\">{{ doc.employee }}</td>\n  </tr>\n\n  <tr>\n    <td class=\"label\">Designation</td>\n    <td class=\"value\">{{ doc.designation or \"\" }}</td>\n\n    <td class=\"label\">Department</td>\n    <td class=\"value\">{{ doc.department or \"\" }}</td>\n  </tr>\n\n  <tr>\n    <td class=\"label\">Date of Joining</td>\n    <td class=\"value\">\n      {% if employee_date_of_joining %}\n        {{ frappe.utils.formatdate(employee_date_of_joining) }}\n      {% endif %}\n    </td>\n\n    <td class=\"label\">Payroll Frequency</td>\n    <td class=\"value\">{{ doc.payroll_frequency or \"\" }}</td>\n  </tr>\n\n  <tr>\n    <td class=\"label\">Salary Period</td>\n    <td class=\"value\">\n      {{ frappe.utils.formatdate(doc.start_date) }}\n      -\n      {{ frappe.utils.formatdate(doc.end_date) }}\n    </td>\n\n    <td class=\"label\">Payment Days</td>\n    <td class=\"value\">{{ doc.payment_days }}</td>\n  </tr>\n\n  <tr>\n    <td class=\"label\">Total Working Days</td>\n    <td class=\"value\">{{ doc.total_working_days }}</td>\n\n    <!--<td class=\"label\">Leave Without Pay</td>-->\n    <!--<td class=\"value\">{{ doc.leave_without_pay }}</td>-->\n  </tr>\n\n</table>\n\n  <!-- ==============================\n       SALARY CALCULATION\n       ============================== -->\n\n  <div class=\"section-title\">\n    Salary Calculation\n  </div>\n\n  <table class=\"salary-table\">\n\n    <thead>\n      <tr>\n        <th>Particulars</th>\n        <th class=\"center\">Days</th>\n        <th class=\"amount\">Rate</th>\n        <th class=\"center\">Effective %</th>\n        <th class=\"amount\">Amount</th>\n      </tr>\n    </thead>\n\n    <tbody>\n\n      {% if doc.salary_breakup %}\n\n        {% for item in doc.salary_breakup %}\n\n        <tr>\n\n          <td>\n            {{ item.particulars }}\n          </td>\n\n          <td class=\"center\">\n            {{ item.days }}\n          </td>\n\n          <td class=\"amount\">\n            {{ frappe.utils.fmt_money(item.rate, currency=doc.currency) }}\n          </td>\n\n          <td class=\"center\">\n            {{ item.effective_percentage }}%\n          </td>\n\n          <td class=\"amount\">\n            {{ frappe.utils.fmt_money(item.amount, currency=doc.currency) }}\n          </td>\n\n        </tr>\n\n        {% endfor %}\n\n      {% endif %}\n\n      <tr class=\"total-row\">\n\n        <th colspan=\"4\">\n          Gross Salary\n        </th>\n\n        <td class=\"amount\">\n          {{ frappe.utils.fmt_money(doc.gross_pay, currency=doc.currency) }}\n        </td>\n\n      </tr>\n\n    </tbody>\n\n  </table>\n\n\n  <!-- ==============================\n     OTHER EARNINGS\n     Show all earnings except Basic\n     ============================== -->\n\n{% set other_earnings = [] %}\n\n{% for item in doc.earnings %}\n  {% if item.salary_component != \"Basic\" %}\n    {% set _ = other_earnings.append(item) %}\n  {% endif %}\n{% endfor %}\n\n{% if other_earnings %}\n\n<div class=\"section-title\">\n  Other Earnings\n</div>\n\n<table class=\"salary-table\">\n\n  <thead>\n    <tr>\n      <th>Salary Component</th>\n      <th class=\"center\">Abbr.</th>\n      <th class=\"amount\">Amount</th>\n    </tr>\n  </thead>\n\n  <tbody>\n\n    {% for item in other_earnings %}\n\n    <tr>\n      <td>\n        {{ item.salary_component }}\n      </td>\n\n      <td class=\"center\">\n        {{ item.abbr }}\n      </td>\n\n      <td class=\"amount\">\n        {{ frappe.utils.fmt_money(item.amount, currency=doc.currency) }}\n      </td>\n    </tr>\n\n    {% endfor %}\n\n    <tr class=\"total-row\">\n      <th colspan=\"2\">\n        Total Other Earnings\n      </th>\n\n      <td class=\"amount\">\n        {{ frappe.utils.fmt_money(\n          other_earnings | sum(attribute=\"amount\"),\n          currency=doc.currency\n        ) }}\n      </td>\n    </tr>\n\n  </tbody>\n\n</table>\n\n{% endif %}\n\n\n  <!-- ==============================\n       ADJUSTMENT\n       Show all deductions\n       ============================== -->\n\n  {% if doc.deductions %}\n\n  <div class=\"section-title\">\n    Adjustment\n  </div>\n\n  <table class=\"salary-table\">\n\n    <thead>\n      <tr>\n        <th>Adjustment</th>\n        <th class=\"center\">Abbr.</th>\n        <th class=\"amount\">Amount</th>\n      </tr>\n    </thead>\n\n    <tbody>\n\n      {% for item in doc.deductions %}\n\n      <tr>\n\n        <td>\n          {{ item.salary_component }}\n        </td>\n\n        <td class=\"center\">\n          {{ item.abbr }}\n        </td>\n\n        <td class=\"amount\">\n          {{ frappe.utils.fmt_money(item.amount, currency=doc.currency) }}\n        </td>\n\n      </tr>\n\n      {% endfor %}\n\n      <tr class=\"total-row\">\n\n        <th colspan=\"2\">\n          Total Adjustment\n        </th>\n\n        <td class=\"amount\">\n          {{ frappe.utils.fmt_money(doc.total_deduction, currency=doc.currency) }}\n        </td>\n\n      </tr>\n\n    </tbody>\n\n  </table>\n\n  {% endif %}\n\n\n  <!-- ==============================\n       NET PAY\n       ============================== -->\n\n  <div class=\"net-pay\">\n    Net Amount Payable:\n    {{ frappe.utils.fmt_money(doc.net_pay, currency=doc.currency) }}\n  </div>\n\n\n  <!-- ==============================\n       AMOUNT IN WORDS\n       ============================== -->\n\n  <div style=\"margin-top: 10px;\">\n    <strong>Amount in Words:</strong>\n    {{ doc.total_in_words }}\n  </div>\n\n\n  <!-- ==============================\n       BANK DETAILS\n       ============================== -->\n\n  <!--{% if doc.bank_name or doc.bank_account_no %}-->\n\n  <!--<table class=\"bank-details\">-->\n\n  <!--  <tr>-->\n  <!--    <td class=\"label\">Mode of Payment</td>-->\n  <!--    <td class=\"value\">-->\n  <!--      {{ doc.mode_of_payment or \"\" }}-->\n  <!--    </td>-->\n\n  <!--    <td class=\"label\">Bank</td>-->\n  <!--    <td class=\"value\">-->\n  <!--      {{ doc.bank_name or \"\" }}-->\n  <!--    </td>-->\n  <!--  </tr>-->\n\n  <!--  <tr>-->\n  <!--    <td class=\"label\">Bank Account No.</td>-->\n  <!--    <td class=\"value\">-->\n  <!--      {{ doc.bank_account_no or \"\" }}-->\n  <!--    </td>-->\n\n  <!--    <td class=\"label\">Currency</td>-->\n  <!--    <td class=\"value\">-->\n  <!--      {{ doc.currency }}-->\n  <!--    </td>-->\n  <!--  </tr>-->\n\n  <!--</table>-->\n\n  <!--{% endif %}-->\n\n\n  <!-- ==============================\n       FOOTER\n       ============================== -->\n\n  <div class=\"footer\">\n    Generated on {{ frappe.utils.format_datetime(doc.creation) }}\n  </div>\n\n</div>\n\n</body>\n</html>",
